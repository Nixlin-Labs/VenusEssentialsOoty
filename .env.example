# ===========================================
# Venus Essentials - Environment Variables
# ===========================================

# --- Server ---
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# --- MongoDB ---
MONGODB_URI=mongodb://localhost:27017/venus_essentials

# --- JWT ---
JWT_ACCESS_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# --- AES Encryption (Frontend) ---
NEXT_PUBLIC_AES_SECRET_KEY=your_aes_secret_key_here

# --- Razorpay ---
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=your_razorpay_key_id

# --- Email (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=Venus Essentials <no-reply@venusessentials.com>

# --- SMS (Placeholder) ---
SMS_API_KEY=your_sms_api_key
SMS_SENDER_ID=VENUS

# --- Media ---
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

# --- Business ---
GST_NUMBER=your_gst_number
COMPANY_NAME=Venus Essentials
COMPANY_ADDRESS=Ooty, Tamil Nadu, India
COMPANY_PHONE=+91-9876543210
COMPANY_EMAIL=contact@venusessentials.com
FREE_SHIPPING_THRESHOLD=500
DEFAULT_SHIPPING_CHARGE=50

# --- Next.js (Customer App) ---
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_SITE_NAME=Venus Essentials
NEXT_PUBLIC_SITE_URL=http://localhost:3000
